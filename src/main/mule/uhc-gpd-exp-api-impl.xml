   <sub-flow name="smsAppointment-subflow" doc:id="0a93d5a1-373e-4e71-94c6-c5a9cdaa5f37" >
		<logger level="INFO" doc:name="SMS Appointment - Start" doc:id="f0c28a87-607a-48ad-9a90-86592ebd1953" message='#["Initiating SMS appointment request"]' />
		<try doc:name="Try" doc:id="9a1b2c3d-4e5f-4678-8a1b-2c3d4e5f6a7b">
			<http:request method="POST" doc:name="Send SMS with OAuth Token" doc:id="e5f6a7b8-c9da-4bde-9a0f-4a5b6c7d8e9f" config-ref="SMS_API_Request_Config" path="/{phoneNumber}/{program}/{templateTag}" sendCorrelationId="NEVER">
				<http:headers ><![CDATA[#[{
				"accept": "application/json",
				"Content-Type": "application/json",
				"X-Upstream-Env": "${secure::sms.api.upstreamEnv}"
}]]]></http:headers>
				<http:uri-params ><![CDATA[#[{
				"phoneNumber": attributes.uriParams.phoneNumber,
				"program": attributes.uriParams.program,
				"templateTag": attributes.uriParams.templateTag
}]]]></http:uri-params>
			</http:request>
			<logger level="INFO" doc:name="SMS Response" doc:id="f6a7b8c9-daeb-4cdf-9a0f-5a6b7c8d9eaf" message='#["SMS API response status: " ++ attributes.statusCode]' />
			<ee:transform doc:name="Return SMS Success Response" doc:id="b2c3d4e5-f6a7-48bc-9d0e-1f2a3b4c5d6e">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus"><![CDATA[200]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			<logger level="INFO" doc:name="SMS Sent Successfully" doc:id="c3d4e5f6-a7b8-49cd-9e0f-2a3b4c5d6e7f" message='#["SMS sent successfully"]' />
			<error-handler>
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="e1f2a3b4-c5d6-4789-9a0b-1c2d3e4f5a6b">
					<!-- surface the real upstream error body/status instead of the generic common-error-handler wrapper -->
					<logger level="ERROR" doc:name="Log upstream SMS error" doc:id="f2a3b4c5-d6e7-4890-8a1b-2c3d4e5f6a7c" message='#["SMS upstream call failed with status " ++ (error.errorMessage.attributes.statusCode default attributes.statusCode) ++ " - " ++ error.description]' />
					<ee:transform doc:name="Return Upstream Error Body" doc:id="a3b4c5d6-e7f8-4901-8b2c-3d4e5f6a7b8d">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
error.errorMessage.payload default { statusCode: "500", statusMessage: error.description }]]></ee:set-payload>
						</ee:message>
						<ee:variables>
							<ee:set-variable variableName="httpStatus"><![CDATA[%dw 2.0
output application/java
---
(error.errorMessage.attributes.statusCode default 500) as Number]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>

<sub-flow xmlns:core="http://www.mulesoft.org/schema/mule/core" name="cancelAppointment-subflow" doc:id="d28375e8-d4ae-446a-a163-42a546106a8a" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
		<ee:transform doc:name="Bulid Request" doc:id="fab871c1-110c-484a-b1cc-e3e2ca899e26">
			<ee:message>
				<ee:set-payload resource="dwl/cancelAppointment/buildRequest.dwl" />
			</ee:message>
		</ee:transform>
		<set-variable value="#[now()]" doc:name="Set Variable" doc:id="05a0ddf0-d80c-4716-afdc-8749c9475070" variableName="startTimeBeforeupdateSFcall"/>
		<salesforce:update doc:name="Update" doc:id="0fbe3045-9ddc-4a72-8504-59f0e8a4ef4d" config-ref="Salesforce_Config" type="Case"/>
		<logger level="INFO" doc:name="Logger" doc:id="367d1bb2-c984-4390-a6bc-c6f597657bf9" message='#[output application/java&#10;---&#10;"createAppointment time after SF Create Call is :  " ++ (now() - vars.startTimeBeforeupdateSFcall)]'/>
		<choice doc:name="Cancel Performed?" doc:id="f5fd33bf-1f40-4cd7-8718-f1ab2288a4f0">
			<when expression="#[payload.successful ~= true]">
				<ee:transform doc:name="Response Payload" doc:id="a9f73440-4b43-47a6-aa54-4d2293d5d9ea">
					<ee:message>
						<ee:set-payload resource="dwl/cancelAppointment/cancelAppointmentResponse.dwl" />
					</ee:message>
		</ee:transform>
				<set-variable value="#[201]" doc:name="Set Variable httpStatusCode=201" doc:id="57e75cf5-6ade-4e11-acd9-ae297a22f22f" variableName="httpStatus" />
			</when>
			<otherwise>
				<ee:transform doc:name="Not Found Payload" doc:id="62940d51-19a6-4147-a934-8a84a012c37f">
					<ee:message>
						<ee:set-payload resource="dwl/cancelAppointment/cancelAppointmentError.dwl" />
					</ee:message>
					
				</ee:transform>
				<set-variable variableName="httpStatus" value='#[%dw 2.0&#10;output application/json&#10;&#10;var sfCode = upper(payload.items[0].payload.errors[0].statusCode default "")&#10;&#10;var badRequestErrors = [&#10;    "INVALID_FIELD",&#10;    "INVALID_FIELD_FOR_INSERT_UPDATE",&#10;    "INVALID_CROSS_REFERENCE_KEY",&#10;    "INVALID_ID_FIELD",&#10;    "INVALID_TYPE",&#10;    "INVALID_OR_NULL_FOR_RESTRICTED_PICKLIST",&#10;    "REQUIRED_FIELD_MISSING",&#10;    "STRING_TOO_LONG",&#10;    "DUPLICATES_DETECTED",&#10;    "MALFORMED_ID",&#10;    "NUMBER_OUTSIDE_VALID_RANGE",&#10;    "FIELD_CUSTOM_VALIDATION_EXCEPTION",&#10;    "INVALID_EMAIL_ADDRESS",&#10;    "INVALID_PHONE_NUMBER",&#10;    "CANNOT_INSERT_UPDATE_ACTIVATE_ENTITY"&#10;]&#10;&#10;---&#10;{&#10;    statusCode:&#10;        if (&#10;            (sfCode contains "INVALID")&#10;            or&#10;            (badRequestErrors contains sfCode)&#10;        )&#10;            400&#10;        else if (&#10;            sfCode == "ENTITY_IS_DELETED"&#10;            or sfCode == "INSUFFICIENT_ACCESS_ON_CROSS_REFERENCE_ENTITY"&#10;        )&#10;            404&#10;        else&#10;            500,&#10;&#10;    message: payload.items[0].payload.errors[0].message default null&#10;}]' />
				<set-variable
    variableName="httpStatus"
    value="#[payload.statusCode]"
    doc:name="Set Variable httpStatus"/>
    <set-variable variableName="errorType" value='#[if ((payload.statusCode default 500) == 400)
                "HTTP:BAD_REQUEST"
              else
                "HTTP:INTERNAL_SERVER_ERROR"]' doc:name="Set Variable ErrorType"/>
			</otherwise>
			</choice>
	
</sub-flow>
    
    
</mule>
