	<sub-flow xmlns:core="http://www.mulesoft.org/schema/mule/core" name="createAppointment-subflow" doc:id="0e8987b2-9207-4980-afcd-00b6093dbb4a" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
		<set-variable value="${secure::appointment.leadTimeHours}" doc:name="Set leadTimeHours" doc:id="6a4d2b18-9c73-4e50-81af-2d7b6e30c495" variableName="leadTimeHours" />
		<ee:transform doc:name="Evaluate lead time" doc:id="5b1f0c34-9a77-4d21-8c0e-2f9a1b7c4d10">
			<ee:variables>
				<ee:set-variable variableName="leadTimeCheck" resource="dwl/createAppointment/leadTimeCheck.dwl" />
			</ee:variables>
		</ee:transform>
		<choice doc:name="Lead time satisfied?" doc:id="c7a2e5d1-3f68-4b0a-9d54-8e1c6a4f2b93">
			<when expression="#[vars.leadTimeCheck.isViolation]">
				<ee:transform doc:name="Lead time error payload" doc:id="d4e8b2f9-16c3-4a7e-b5d0-9c3f7a1e6082">
					<ee:message>
						<ee:set-payload resource="dwl/createAppointment/leadTimeError.dwl" />
					</ee:message>
				</ee:transform>
				<set-variable value="#[400]" doc:name="Set httpStatus 400" doc:id="a1c9d3e7-52b4-48f1-9e6a-7b2d0c5f4a18" variableName="httpStatus" />
				<set-variable value='#["HTTP:BAD_REQUEST"]' doc:name="Set errorType" doc:id="f3b7a0d2-6e51-4c98-8a2f-1d9e4b6c7503" variableName="errorType" />
				<logger level="INFO" doc:name="Log lead time rejection" doc:id="b8d1f6a4-0c37-4e29-95b6-3a7c2e8d1f40" message='#["createAppointment rejected: requested date/time is inside the configured lead time of " ++ vars.leadTimeCheck.leadTimeHours ++ " hours"]' />
			</when>
			<otherwise>
		<ee:transform doc:name="Bulid Request" doc:id="94d9d980-0b95-49ef-b05a-f716f709e1f1">
			<ee:message>
				<ee:set-payload resource="dwl/createAppointment/buildRequest.dwl" />
			</ee:message>
		</ee:transform>
		<set-variable value="#[now()]" doc:name="Set Variable" doc:id="fa0cfd08-c769-4977-b9b2-0af425d1cd2e" variableName="startTimeBeforeCreateSFcall"/>
		<salesforce:create doc:name="Create" doc:id="397e39ed-6458-4513-8666-a1fb62346f6f" config-ref="Salesforce_Config" type="CDAS_Appointment_Intake_Request__c">
		</salesforce:create>
		<logger level="INFO" doc:name="Logger" doc:id="e4d8add0-7277-449b-b4f6-f2993bfe589d" message='#[output application/java&#10;---&#10;"createAppointment time after SF Create Call is :  " ++ (now() - vars.startTimeBeforeCreateSFcall)]'/>
		<choice doc:name="Appointment Created?" doc:id="7aea3ad8-29e7-4686-ad67-faff12dc1baf">
			<when expression="#[payload.successful ~= true]">
				<ee:transform doc:name="Response Payload" doc:id="a17324b2-37a9-46a6-990a-2f764045ae40">
					<ee:message>
						<ee:set-payload resource="dwl/createAppointment/createOppurtunityResponse.dwl" />
					</ee:message>
		</ee:transform>
				<set-variable value="#[201]" doc:name="Set Variable httpStatusCode=201" doc:id="3810ec8c-6121-4be7-9c40-4538b0ed7f52" variableName="httpStatus" />
			</when>
			<otherwise>
				<ee:transform doc:name="Not Found Payload" doc:id="e7014f27-664c-43e4-87ae-8fea5347dab8">
					<ee:message>
						<ee:set-payload resource="dwl/createAppointment/createOppurtunityError.dwl" />
					</ee:message>
					
				</ee:transform>
				<set-variable variableName="httpStatus" value='#[var sfCode = upper(payload.items[0].payload.errors[0].statusCode default "")
    var badRequestErrors = [
        "REQUIRED_FIELD_MISSING",
        "STRING_TOO_LONG",
        "DUPLICATES_DETECTED",
        "MALFORMED_ID",
        "NUMBER_OUTSIDE_VALID_RANGE",
        "FIELD_CUSTOM_VALIDATION_EXCEPTION"
    ]
    ---
    if (
        (sfCode contains "INVALID") or
        ((badRequestErrors contains sfCode) default false)
    )
        400
    else
        500]' />
				<set-variable
    variableName="httpStatus"
    value="#[payload.statusCode]"
    doc:name="Set Variable httpStatus"/>
    <set-variable variableName="errorType" value='#[if ((payload.statusCode default 500) == 400)
                "HTTP:BAD_REQUEST"
              else
                "HTTP:INTERNAL_SERVER_ERROR"]' doc:name="Set Variable ErrorType"/>
			</otherwise>
			</choice>
			</otherwise>
		</choice>
	
</sub-flow>
<sub-flow name="salesforce-sys-slot-availability-subflow" doc:id="7a0ba39a-aee3-4e20-a7a0-bbb06b845216" >
  <logger level="INFO" doc:name="Logger before sf query call" doc:id="6e6128cb-73ff-4542-bfaf-706f94b3754b" message='#["Initiating Sf query call"]' />
  <try doc:name="Try" doc:id="07a41394-c33f-47bb-af94-b8af85386cfb" >
   <salesforce:query doc:name="Query-appointments" doc:id="835eeb71-dddb-49d0-8125-29028cd3ceca" config-ref="Salesforce_Config" headers='#[{"QueryOptions": {"batchSize": 200}}]'>
   <salesforce:salesforce-query><![CDATA[SELECT Id, Appointment_Date__c, Appointment_Time__c, Balance_Planned_Capacity__c FROM CDAS_Slot_Master__c where Appointment_Date__c >= :startdate and Appointment_Date__c <= :enddate and Balance_Planned_Capacity__c > 0 order by Appointment_Date__c asc]]></salesforce:salesforce-query>
   <salesforce:parameters><![CDATA[#[output application/json
---
{
 "enddate" : vars.vQParams.endDate as Date,
 "startdate": vars.vQParams.effectiveStartDate as Date
 }]]]></salesforce:parameters>
  </salesforce:query>
   <ee:transform doc:name="Map output response" doc:id="13e0d52b-2ed3-44a5-82c0-e837ed45d172">
   <ee:message>
     <ee:set-payload resource="dw/responseMap.dwl" />
   </ee:message>
  </ee:transform>
   <logger level="INFO" doc:name="Logger after sf query call" doc:id="16ba66b7-6fc6-4c69-82bc-c84c5ece437d" message='#["Sf query call completed"]' />
   <error-handler >
    <on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="dc159191-8155-45fb-b094-4bc9b5284a87" >
     <ee:transform doc:name="Error message" doc:id="b98e83e8-3efc-4836-819b-4463638bbbd4" >
      <ee:message >
       <ee:set-payload resource="dw/errorResponse500.dwl" />
      </ee:message>
     </ee:transform>
     <logger level="ERROR" doc:name="Log error" doc:id="e36ac049-6f0a-45b4-aed1-76d2d448c9e4" message="#[payload]"/>
     <set-variable value='#["500"]' doc:name="Set httpStatus" doc:id="ba8eebcc-ca04-4b99-aaec-c56e8271ad32" variableName="httpStatus"/>
    </on-error-continue>
   </error-handler>
  </try>
 </sub-flow>
	<sub-flow name="salesforce-sys-cancel-appointment-subflow" doc:id="af5b6b2c-28f4-4fce-807d-5e6ac707c5c2" >
