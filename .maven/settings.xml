<?xml version="1.0" encoding="UTF-8"?>
<settings xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 http://maven.apache.org/xsd/settings-1.2.0.xsd" xmlns="http://maven.apache.org/SETTINGS/1.2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <pluginGroups>
    <pluginGroup>org.mule.tools</pluginGroup>
  </pluginGroups>
  <servers>
  <server>
      <id>Repository</id>
      <username>~~~Client~~~</username>
      <password>${exchange.client.id}~?~${exchange.client.secret}</password>
    </server>
    <server>
      <id>anypoint-exchange-v3</id>
      <username>~~~Client~~~</username>
      <password>${exchange.client.id}~?~${exchange.client.secret}</password>
    </server>
    <server>
      <username>mrcrm</username>
      <password>${jfrog.credential}</password>
      <id>central</id>
    </server>
    <server>
      <username>mrcrm</username>
      <password>${jfrog.credential}</password>
      <id>snapshots</id>
    </server>
    <server>
      <username>mrcrm</username>
      <password>${jfrog.credential}</password>
      <id>repoauth</id>
    </server>
  </servers>
  <mirrors>
    <mirror>
      <mirrorOf>*</mirrorOf>
      <name>repoauth</name>
      <url>https://repo1.uhc.com:443/artifactory/repoauth</url>
      <id>repoauth</id>
    </mirror>
  </mirrors>
  <profiles>
    <profile>
      <repositories>
        <repository>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
          <id>central</id>
          <name>libs-releases</name>
          <url>https://repo1.uhc.com:443/artifactory/libs-releases</url>
        </repository>
        <repository>
          <snapshots />
          <id>snapshots</id>
          <name>libs-snapshots</name>
          <url>https://repo1.uhc.com:443/artifactory/libs-snapshots</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
          <id>central</id>
          <name>libs-releases</name>
          <url>https://repo1.uhc.com:443/artifactory/libs-releases</url>
        </pluginRepository>
        <pluginRepository>
          <snapshots />
          <id>snapshots</id>
          <name>libs-snapshots</name>
          <url>https://repo1.uhc.com:443/artifactory/libs-snapshots</url>
        </pluginRepository>
      </pluginRepositories>
      <id>artifactory</id>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>artifactory</activeProfile>
  </activeProfiles>
</settings>
